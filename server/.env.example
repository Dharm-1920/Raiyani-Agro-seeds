PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/raiyani_agro
JWT_SECRET=
# Generate a private secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLIENT_URL=http://localhost:5173
# Public website address used for email links and OAuth redirects.
# On Render: https://raiyaniagroseeds.onrender.com
APP_URL=http://localhost:5173
# Google Cloud OAuth client (Web application). Keep the secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local callback below; production uses https://raiyaniagroseeds.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Transactional email over HTTPS (works on Render Free, which blocks SMTP).
# Verify MAIL_FROM as a sender in Brevo before enabling.
BREVO_API_KEY=
MAIL_FROM=raiyaniagroseeds.support@gmail.com
# Optional SMTP alternative for local development or a host that allows SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional automatic WhatsApp PDF invoices. Requires an approved Twilio WhatsApp sender
# and approved document template: body variables 1=order, 2=total;
# media URL https://raiyaniagroseeds.onrender.com/{{3}} (3=expiring PDF path).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Optional: contact email for the MyMemory automatic Gujarati translation service.
# Product translations are saved in MongoDB. Manual Gujarati fields work offline.
MYMEMORY_EMAIL=
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=
# Set your own private admin password (at least 8 characters), then run npm run seed.
# UPI QR: set the shop's real receiving UPI ID and account name.
# Leave blank for Cash on Delivery only.
SHOP_UPI_ID=
SHOP_UPI_NAME=Raiyani Agro Seeds
# Purchase invoices are generated by the Node API.
SHOP_NAME=Raiyani Agro Seeds
SHOP_ADDRESS=Gondal, Gujarat
# Optional legacy Python service
PYTHON_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=change-me-internal-key
