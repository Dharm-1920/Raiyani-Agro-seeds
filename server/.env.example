PORT=5000
# Docker Compose starts a local replica set for atomic counter-bill stock updates.
# Production: use the existing private MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/raiyani_agro?replicaSet=rs0
JWT_SECRET=
# Generate a private secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLIENT_URL=http://localhost:5173
# Public website address used for email links and OAuth redirects.
# On Render: https://raiyaniagroseeds.onrender.com
APP_URL=http://localhost:5173
# Google Cloud OAuth client (Web application). Keep the secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local callback below; production uses https://raiyaniagroseeds.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Transactional email over HTTPS (works on Render Free, which blocks SMTP).
# Verify MAIL_FROM as a sender in Brevo before enabling.
BREVO_API_KEY=
MAIL_FROM=raiyaniagroseeds.support@gmail.com
# Optional SMTP alternative for local development or a host that allows SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Direct Meta WhatsApp Cloud API (see docs/meta-whatsapp-setup.md).
# Keep sending disabled until the sender, webhook and templates are verified.
WHATSAPP_PROVIDER=meta
META_WHATSAPP_SEND_ENABLED=false
META_WHATSAPP_BUSINESS_NUMBER=+919925021235
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
# Set the supported Graph API version shown in your Meta app, e.g. v23.0.
META_WHATSAPP_API_VERSION=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_INVOICE_TEMPLATE=
META_WHATSAPP_REMINDER_TEMPLATE=
META_WHATSAPP_RESTOCK_TEMPLATE=
# Optional approved Gujarati variants (language code gu); otherwise use English messages.
META_WHATSAPP_INVOICE_TEMPLATE_GU=
META_WHATSAPP_REMINDER_TEMPLATE_GU=
META_WHATSAPP_RESTOCK_TEMPLATE_GU=
# Legacy Twilio mode is still supported if WHATSAPP_PROVIDER is not meta.
# Optional automatic WhatsApp PDF invoices. Requires an approved Twilio WhatsApp sender
# and approved document template: body variables 1=order, 2=total;
# media URL https://raiyaniagroseeds.onrender.com/{{3}} (3=expiring PDF path).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Separate approved payment reminder template: 1=customer name, 2=bill reference, 3=outstanding INR amount.
# First reminder is 15 days after billing; repeats every 15 days until paid, with customer consent.
TWILIO_WHATSAPP_REMINDER_CONTENT_SID=
# Optional: contact email for the MyMemory automatic Gujarati translation service.
# Product translations are saved in MongoDB. Manual Gujarati fields work offline.
MYMEMORY_EMAIL=
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=
# Set your own private admin password (at least 8 characters), then run npm run seed.
# UPI QR: set the shop's real receiving UPI ID and account name.
# Leave blank for Cash on Delivery only.
SHOP_UPI_ID=
SHOP_UPI_NAME=Raiyani Agro Seeds
# Purchase invoices are generated by the Node API.
SHOP_NAME=Raiyani Agro Seeds
SHOP_ADDRESS=Shop No 2, New Marketing Yard, Gondal, Gujarat 360311, India
SHOP_PHONE=+91 97146 23500
SHOP_EMAIL=raiyaniagroseeds.support@gmail.com
# Optional legacy Python service
PYTHON_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=change-me-internal-key
